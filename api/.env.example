# Copy to .env. ConfigModule (@nestjs/config) loads this file from the working
# directory on startup; variables already set in the environment take precedence.

# Port the API listens on.
PORT=3000

# PostgreSQL connection string. Required. Matches docker-compose.yml.
DATABASE_URL=postgres://opensurvey:opensurvey@localhost:5433/opensurvey

# NestJS Observe (optional). `npx @nestjs/observe link` fills these in.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
